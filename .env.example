# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# CampusPulse Configuration
DATABASE_URL="postgres://campus:password@localhost:5432/campuspulse"
JWT_SECRET="super-secure-jwt-secret-key-campuspulse"
AI_API_KEY="MY_AI_API_KEY"
MAPS_API_KEY="MY_MAPS_API_KEY"
STORAGE_URL="https://storage.googleapis.com/campuspulse"
EMAIL_PROVIDER="smtp"
COLLEGE_EMAIL_DOMAIN="college.edu"

